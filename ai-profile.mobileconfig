<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadDisplayName</key>
            <string>AI App Launcher</string>
            <key>PayloadDescription</key>
            <string>Configuration for AI Application</string>
            <key>PayloadIdentifier</key>
            <string>com.example.aiwebclip</string>
            <key>PayloadOrganization</key>
            <string>Your Company</string>
            <key>PayloadUUID</key>
            <string>$(uuidgen | tr '[:upper:]' '[:lower:]')</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>URL</key>
            <string>https://yourapp.com/ai</string>
            <key>Icon</key>
            <data>
            <!-- Base64 encoded icon would go here -->
            </data>
            <key>IsRemovable</key>
            <true/>
            <key>Label</key>
            <string>AI App</string>
            <key>Precomposed</key>
            <true/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>AI App Configuration</string>
    <key>PayloadIdentifier</key>
    <string>com.example.aiwebclip.profile</string>
    <key>PayloadOrganization</key>
    <string>Your Company</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>$(uuidgen | tr '[:upper:]' '[:lower:]')</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
